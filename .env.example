# Local/demo configuration. Keep real values outside source control.
SQL_SERVER=
SQL_DATABASE=
SQL_AUTHENTICATION=azure_access_token
AZURE_SQL_ACCESS_TOKEN=

# Azure Key Vault example (Managed Identity / DefaultAzureCredential).
ORBELION_KEY_VAULT_NAME=

# Dynamic Odoo bundle resolved from Key Vault for example_client:
# example-client-odoo-url
# example-client-odoo-database
# example-client-odoo-username
# example-client-odoo-api-key

# GitHub OIDC example variables are configured as GitHub Environment variables:
